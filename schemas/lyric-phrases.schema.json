{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "song_asset",
    "occurrences"
  ],
  "properties": {
    "song_asset": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*:).+$"
    },
    "occurrences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "phrases"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "phrases": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "text",
                "segment_index"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "segment_index": {
                  "type": "integer",
                  "minimum": 0
                },
                "char_start": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
