{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Eight-file renderer runtime bundle (key by filename)",
  "type": "object",
  "required": [
    "narrative-edit.json",
    "narrative-media.json",
    "media-exclusions.json",
    "chorus-alignment.json",
    "outro-alignment.json",
    "copy.json",
    "matchcut.json",
    "stopmotion.json"
  ],
  "properties": {
    "narrative-edit.json": {
      "$ref": "#/$defs/plan"
    },
    "narrative-media.json": {
      "type": "object",
      "required": [
        "status",
        "assets"
      ],
      "properties": {
        "status": {
          "const": "ready"
        },
        "assets": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "media-exclusions.json": {
      "type": "object",
      "required": [
        "excluded_stems"
      ],
      "properties": {
        "excluded_stems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "chorus-alignment.json": {
      "type": "object",
      "required": [
        "fps",
        "occurrences"
      ],
      "properties": {
        "fps": {
          "type": "integer",
          "minimum": 1
        },
        "occurrences": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "cues"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "cues": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/cue"
                }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "outro-alignment.json": {
      "$ref": "#/$defs/outro"
    },
    "copy.json": {
      "$ref": "#/$defs/copy"
    },
    "matchcut.json": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "stopmotion.json": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "rect": {
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": true
    },
    "layout": {
      "type": "object",
      "required": [
        "family",
        "media",
        "words",
        "radius",
        "mat",
        "tilt",
        "align",
        "typeSize",
        "shade",
        "typeface",
        "inset"
      ],
      "properties": {
        "family": {
          "enum": [
            "near-bleed",
            "contact-print",
            "cinema",
            "milestone",
            "family-album"
          ]
        },
        "media": {
          "$ref": "#/$defs/rect"
        },
        "words": {
          "$ref": "#/$defs/rect"
        },
        "radius": {
          "type": "number",
          "minimum": 0
        },
        "mat": {
          "type": "number",
          "minimum": 0
        },
        "tilt": {
          "type": "number"
        },
        "align": {
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "typeSize": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "shade": {
          "enum": [
            "cream",
            "blue",
            "lavender",
            "peach",
            "rose"
          ]
        },
        "typeface": {
          "enum": [
            "serif",
            "sans"
          ]
        },
        "inset": {
          "type": "number",
          "minimum": 0
        },
        "foot": {
          "type": "number",
          "minimum": 0
        },
        "backing": {
          "$ref": "#/$defs/rect"
        }
      },
      "additionalProperties": true
    },
    "asset": {
      "type": "object",
      "required": [
        "asset",
        "original",
        "kind",
        "dimensions"
      ],
      "properties": {
        "asset": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*:).+$"
        },
        "original": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*:).+$"
        },
        "kind": {
          "enum": [
            "photo",
            "video"
          ]
        },
        "dimensions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "playbackRate": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "crop": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number"
          }
        },
        "poster": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*:).+$"
        }
      },
      "additionalProperties": true
    },
    "shot": {
      "type": "object",
      "required": [
        "id",
        "usage",
        "kind",
        "canonical_original_source",
        "captured_at",
        "date_basis",
        "song_start_frame",
        "song_end_frame",
        "duration_in_frames"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "usage": {
          "enum": [
            "baseline",
            "chorus_slot"
          ]
        },
        "kind": {
          "enum": [
            "photo",
            "video"
          ]
        },
        "canonical_original_source": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*:).+$"
        },
        "captured_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "date_basis": {
          "type": "object"
        },
        "song_start_frame": {
          "type": "integer",
          "minimum": 0
        },
        "song_end_frame": {
          "type": "integer",
          "minimum": 0
        },
        "duration_in_frames": {
          "type": "integer",
          "minimum": 1
        },
        "frameLayout": {
          "$ref": "#/$defs/layout"
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "usage": {
                "const": "baseline"
              }
            }
          },
          "then": {
            "required": [
              "frameLayout"
            ]
          }
        }
      ]
    },
    "word": {
      "type": "object",
      "required": [
        "text",
        "start_frame",
        "end_frame",
        "char_start",
        "char_end"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "start_frame": {
          "type": "integer",
          "minimum": 0
        },
        "end_frame": {
          "type": "integer",
          "minimum": 0
        },
        "char_start": {
          "type": "integer",
          "minimum": 0
        },
        "char_end": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "cue": {
      "type": "object",
      "required": [
        "id",
        "text",
        "start_frame",
        "end_frame",
        "words"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "start_frame": {
          "type": "integer",
          "minimum": 0
        },
        "end_frame": {
          "type": "integer",
          "minimum": 0
        },
        "words": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/word"
          }
        },
        "accent_beat_frames": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "additionalProperties": true
    },
    "outro": {
      "type": "object",
      "required": [
        "fps",
        "status",
        "lines",
        "final_line_id"
      ],
      "properties": {
        "fps": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "type": "string"
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cue"
          }
        },
        "final_line_id": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "plan": {
      "type": "object",
      "required": [
        "fps",
        "opening",
        "main_duration_in_frames",
        "total_frames",
        "shots",
        "assets",
        "choruses",
        "outro_alignment"
      ],
      "properties": {
        "fps": {
          "type": "integer",
          "minimum": 1
        },
        "opening": {
          "type": "object",
          "required": [
            "duration_in_frames"
          ],
          "properties": {
            "duration_in_frames": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": true
        },
        "main_duration_in_frames": {
          "type": "integer",
          "minimum": 1
        },
        "total_frames": {
          "type": "integer",
          "minimum": 1
        },
        "shots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/shot"
          }
        },
        "assets": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/asset"
          }
        },
        "choruses": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "outro_alignment": {
          "$ref": "#/$defs/outro"
        },
        "story_captions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/storyCaption"
          }
        }
      },
      "additionalProperties": true
    },
    "copy": {
      "type": "object",
      "required": [
        "strings",
        "assets",
        "opening"
      ],
      "properties": {
        "strings": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "assets": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "opening": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "storyCaption": {
      "type": "object",
      "required": [
        "id",
        "text",
        "start_frame",
        "end_frame"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "start_frame": {
          "type": "integer",
          "minimum": 0
        },
        "end_frame": {
          "type": "integer",
          "minimum": 1
        },
        "placement": {
          "enum": [
            "bottom",
            "left",
            "right"
          ]
        },
        "label": {
          "type": "string"
        },
        "date_label": {
          "type": "string"
        },
        "size": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": true
    }
  }
}
